<# radar-sim: connect this Windows PC to the Linux simulation service. #>
[CmdletBinding()]
param()

$ErrorActionPreference = "Stop"
$ServerUrl = [Text.Encoding]::UTF8.GetString(
    [Convert]::FromBase64String("__RSIM_SERVER_URL_BASE64__")
).TrimEnd('/')
$Mode = "__RSIM_WINDOWS_MODE__"
$Owner = ""
try {
    if ($env:RSIM_OWNER_B64) {
        $Owner = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:RSIM_OWNER_B64))
    } else {
        $Owner = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("__RSIM_OWNER_BASE64__"))
    }
} catch { $Owner = "" }
$Base = if ($env:LOCALAPPDATA) { $env:LOCALAPPDATA } else { Join-Path $HOME "AppData\Local" }
$InstallRoot = Join-Path $Base "radar-sim"
$AppRoot = Join-Path $InstallRoot "app"
$DataRoot = Join-Path $InstallRoot "data"
$WorkRoot = Join-Path $env:TEMP ("radar-sim-connect-" + [Guid]::NewGuid().ToString("N"))
$Archive = Join-Path $WorkRoot "package.zip"
$Expanded = Join-Path $WorkRoot "package"
$PreviousAppBackup = Join-Path $WorkRoot "previous-app"
$PreviousConfigBackup = Join-Path $WorkRoot "previous-config"
$PreviousStateBackedUp = $false

function Step([string]$message) { Write-Host "`n==> $message" -ForegroundColor Cyan }
function Fail([string]$message) { Write-Host "`nConnection failed: $message" -ForegroundColor Red; exit 1 }

function Invoke-WithRetry {
    param(
        [Parameter(Mandatory = $true)][scriptblock]$Operation,
        [Parameter(Mandatory = $true)][string]$Description,
        [int]$Attempts = 5
    )
    $lastError = $null
    foreach ($attempt in 1..$Attempts) {
        try { return & $Operation }
        catch {
            $lastError = $_
            if ($attempt -ge $Attempts) { throw }
            $delay = [Math]::Min(2 * $attempt, 8)
            Write-Host "$Description was temporarily unavailable; retrying ($attempt/$Attempts)..." -ForegroundColor Yellow
            Start-Sleep -Seconds $delay
        }
    }
    throw $lastError
}

function Get-Sha256([string]$Path) {
    # Do not depend on the PowerShell Utility module here.  A launcher started
    # from PowerShell 7 can put its module directory ahead of Windows
    # PowerShell 5.1's module path, where the usual PowerShell hash command is
    # not available.  The
    # .NET implementation is present on every supported Windows host.
    $sha = [Security.Cryptography.SHA256]::Create()
    $stream = $null
    try {
        $stream = [IO.File]::OpenRead($Path)
        return ([BitConverter]::ToString($sha.ComputeHash($stream)) -replace '-', '').ToLowerInvariant()
    } finally {
        if ($stream) { $stream.Dispose() }
        $sha.Dispose()
    }
}

function Find-Python310 {
    foreach ($candidate in @("python", "py")) {
        try {
            $version = & $candidate -c "import sys; print('.'.join(map(str, sys.version_info[:3]))); raise SystemExit(0 if sys.version_info >= (3, 10) else 1)" 2>$null
            if ($LASTEXITCODE -eq 0) { return "$candidate $version" }
        } catch { }
    }
    return $null
}

function Refresh-ProcessPath {
    $machinePath = [Environment]::GetEnvironmentVariable("Path", "Machine")
    $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
    $knownPython = Join-Path $env:LOCALAPPDATA "Programs\Python\Python312"
    # Put the freshly installed per-user runtime first; an older corporate
    # Python earlier in Machine PATH must not make bootstrap fail incorrectly.
    $env:Path = @($knownPython, (Join-Path $knownPython "Scripts"), $machinePath, $userPath) -join ';'
}

function Stop-ProcessTreeIfPresent([int]$ProcessId) {
    if ($ProcessId -le 0 -or -not (Get-Process -Id $ProcessId -ErrorAction SilentlyContinue)) {
        return
    }
    # Parent/child shutdown is inherently racy: terminating the supervisor may
    # remove a child PID that was captured milliseconds earlier.  Native
    # taskkill reports that already-stopped PID as an error; for an idempotent
    # installer, "not found" means the requested end state was reached.
    $savedErrorActionPreference = $ErrorActionPreference
    try {
        $ErrorActionPreference = "Continue"
        & taskkill.exe /PID $ProcessId /T /F *> $null
    } catch { } finally {
        $ErrorActionPreference = $savedErrorActionPreference
    }
    Wait-Process -Id $ProcessId -Timeout 15 -ErrorAction SilentlyContinue
}

function Stop-PreviousConnector {
    # An upgrade must stop the old supervisor before replacing its source.
    # Otherwise its watchdog can restart the old runtime while files are being
    # copied, or the new supervisor can lose the single-instance mutex race.
    $configPath = Join-Path $InstallRoot "install.json"
    $existing = $null
    if (Test-Path $configPath) {
        try { $existing = Get-Content -Raw -Encoding UTF8 $configPath | ConvertFrom-Json } catch { }
    }
    if ($existing -and $existing.startup_name) {
        Stop-ScheduledTask -TaskName ([string]$existing.startup_name) -ErrorAction SilentlyContinue
    }
    if ($existing -and $existing.watchdog_name) {
        Stop-ScheduledTask -TaskName ([string]$existing.watchdog_name) -ErrorAction SilentlyContinue
        Unregister-ScheduledTask -TaskName ([string]$existing.watchdog_name) -Confirm:$false -ErrorAction SilentlyContinue
    }
    $pidPath = Join-Path $InstallRoot "connector.pid"
    if (Test-Path $pidPath) {
        try {
            $connectorPid = [int](Get-Content -Raw -Encoding ASCII $pidPath)
            if ($connectorPid -gt 0 -and (Get-Process -Id $connectorPid -ErrorAction SilentlyContinue)) {
                Stop-ProcessTreeIfPresent $connectorPid
            }
        } catch { }
        Remove-Item -LiteralPath $pidPath -Force -ErrorAction SilentlyContinue
    }
    # Recover installations whose pid file was lost while the supervisor or
    # Python child survived.  Match only this user's exact AppRoot so another
    # checkout or another Windows profile is never terminated.
    $normalizedAppRoot = ([IO.Path]::GetFullPath($AppRoot)).Replace('/', '\').ToLowerInvariant()
    $remainingPids = @(
        Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
            Where-Object {
                $line = ([string]$_.CommandLine).Replace('/', '\').ToLowerInvariant()
                $line.Contains($normalizedAppRoot) -and (
                    $line.Contains('start_windows.ps1') -or
                    ($line.Contains('rsim.py') -and $line -match '\sagent(?:\s|$)')
                )
            } |
            Select-Object -ExpandProperty ProcessId -Unique
    )
    foreach ($processId in $remainingPids) {
        Stop-ProcessTreeIfPresent ([int]$processId)
    }
}

function Get-OneClickRebindRequired {
    # The Web-generated installer already carries the current page owner.  A
    # Windows profile may still contain a previous explicit user binding (for
    # example after a test user or a different Web/SDK identity was used on
    # this PC).  Do not make the user type an NTID again: rebind only when the
    # old owner has no unfinished jobs, and let bootstrap create a new stable
    # Agent ID for the current owner.
    $configPath = Join-Path $InstallRoot "install.json"
    if (-not (Test-Path -LiteralPath $configPath) -or -not $Owner) { return $false }
    $existing = $null
    try { $existing = Get-Content -Raw -Encoding UTF8 $configPath | ConvertFrom-Json } catch { return $false }
    $oldOwner = [string]($existing.owner | ForEach-Object { $_ })
    if (-not $oldOwner -or [string]::Equals($oldOwner.Trim(), $Owner.Trim(), [StringComparison]::OrdinalIgnoreCase)) {
        return $false
    }
    # Preserve the established one-time migration for old generated browser/
    # SDK labels; bootstrap already handles that transition without changing
    # the Agent ID.
    if ($oldOwner -match '^(?:user-)?(?:web|sdk)-[0-9a-f]{24,64}$' -and $Owner -match '^user-[a-z0-9_.-]+$') {
        return $false
    }
    Write-Host "This PC is currently bound to '$oldOwner'; the current Web/SDK identity is '$Owner'." -ForegroundColor Yellow
    Write-Host "Checking the old identity for unfinished tasks before automatic rebind..." -ForegroundColor Yellow
    try {
        $headers = @{ "X-Rsim-User" = $oldOwner }
        $snapshot = Invoke-RestMethod -Method Get -Uri "$ServerUrl/api/v1/jobs?limit=100" `
            -Headers $headers -TimeoutSec 15
        $active = @(
            @($snapshot.jobs) | Where-Object {
                [string]$_.status -notin @("succeeded", "partial", "failed", "cancelled")
            }
        )
        if ($active.Count -gt 0) {
            Fail "This PC has $($active.Count) unfinished task(s) under '$oldOwner'. Finish or cancel them before connecting it to '$Owner'."
        }
    } catch {
        if ($_.Exception.Message -like "This PC has *unfinished task*") { throw }
        Fail "Could not safely verify the previous identity's tasks before rebinding. Keep the original Web/SDK identity or contact the service administrator. Detail: $($_.Exception.Message)"
    }
    return $true
}

function Reset-InstalledApplication {
    # Keep the isolated Python environment, but replace every source/runtime
    # file.  Copying over an old tree leaves removed modules and timestamp-
    # valid ``.pyc`` files behind; a one-character contract bump can then run
    # old bytecode even though the visible .py file is current.
    New-Item -ItemType Directory -Force -Path $AppRoot | Out-Null
    foreach ($entry in @(Get-ChildItem -LiteralPath $AppRoot -Force -ErrorAction SilentlyContinue)) {
        if ($entry.Name -ieq ".venv") { continue }
        Remove-Item -LiteralPath $entry.FullName -Recurse -Force -ErrorAction Stop
    }
}

function Backup-InstalledState {
    # Keep source/config rollback state in the per-attempt work directory.
    # The isolated .venv is intentionally not copied: it is shared by old and
    # new connector source trees and is never removed by Reset-InstalledApplication.
    if (Test-Path -LiteralPath $AppRoot) {
        New-Item -ItemType Directory -Force -Path $PreviousAppBackup | Out-Null
        foreach ($entry in @(Get-ChildItem -LiteralPath $AppRoot -Force -ErrorAction SilentlyContinue)) {
            if ($entry.Name -ieq ".venv") { continue }
            Copy-Item -LiteralPath $entry.FullName -Destination $PreviousAppBackup -Recurse -Force -ErrorAction Stop
        }
    }
    New-Item -ItemType Directory -Force -Path $PreviousConfigBackup | Out-Null
    foreach ($path in @(
        $ConfigPath,
        $SecretsPath,
        (Join-Path $DataRoot "install.backup.json")
    )) {
        if (Test-Path -LiteralPath $path) {
            Copy-Item -LiteralPath $path -Destination $PreviousConfigBackup -Force -ErrorAction Stop
        }
    }
}

function Restore-InstalledState {
    if (Test-Path -LiteralPath $PreviousAppBackup) {
        New-Item -ItemType Directory -Force -Path $AppRoot | Out-Null
        foreach ($entry in @(Get-ChildItem -LiteralPath $AppRoot -Force -ErrorAction SilentlyContinue)) {
            if ($entry.Name -ieq ".venv") { continue }
            Remove-Item -LiteralPath $entry.FullName -Recurse -Force -ErrorAction SilentlyContinue
        }
        Copy-Item -Path (Join-Path $PreviousAppBackup '*') -Destination $AppRoot -Recurse -Force -ErrorAction Stop
    }
    if (Test-Path -LiteralPath $PreviousConfigBackup) {
        foreach ($name in @("install.json", "credentials.json", "install.backup.json")) {
            $saved = Join-Path $PreviousConfigBackup $name
            if (-not (Test-Path -LiteralPath $saved)) { continue }
            $destination = if ($name -ieq "install.backup.json") {
                Join-Path $DataRoot $name
            } else {
                Join-Path $InstallRoot $name
            }
            Copy-Item -LiteralPath $saved -Destination $destination -Force -ErrorAction Stop
        }
    }
}

function Restore-PreviousConnector {
    if (-not $PreviousStateBackedUp) { return }
    try {
        Restore-InstalledState
        $savedConfigPath = Join-Path $PreviousConfigBackup "install.json"
        $saved = if (Test-Path -LiteralPath $savedConfigPath) {
            Get-Content -Raw -Encoding UTF8 $savedConfigPath | ConvertFrom-Json
        } else { $null }
        $bootstrap = Join-Path $AppRoot "scripts\bootstrap.ps1"
        if ($saved -and (Test-Path -LiteralPath $bootstrap)) {
            $restoreMode = [string]($saved.mode | ForEach-Object { $_ })
            if (-not $restoreMode) { $restoreMode = "unified" }
            $restoreControlPlane = [string]($saved.control_plane | ForEach-Object { $_ })
            if (-not $restoreControlPlane) { $restoreControlPlane = "linux" }
            $restoreArgs = @(
                "-Mode", $restoreMode,
                "-ControlPlane", $restoreControlPlane,
                "-ServerUrl", ([string]$saved.server_url),
                "-Owner", ([string]$saved.owner),
                "-InstallRoot", $InstallRoot,
                "-SkipDeps", "-RegisterStartup", "-Start"
            )
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $bootstrap @restoreArgs
            if ($LASTEXITCODE -eq 0) { return }
        }
        $fallbackStart = Join-Path $AppRoot "scripts\start_windows.ps1"
        if (Test-Path -LiteralPath $fallbackStart) {
            $fallbackArgs = @(
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $fallbackStart,
                "-InstallRoot", $InstallRoot, "-Background", "-NoBrowser"
            )
            Start-Process -FilePath "powershell.exe" -ArgumentList $fallbackArgs `
                -WorkingDirectory $AppRoot -WindowStyle Hidden | Out-Null
        }
    } catch {
        Write-Warning "Automatic Connector rollback failed; the previous install files are retained in $PreviousAppBackup."
    }
}

if ($env:OS -ne "Windows_NT") { Fail "Run this file on the Windows PC that needs to be connected." }

try {
    $serverHost = ([Uri]$ServerUrl).Host
    $bypass = @($env:NO_PROXY -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    if ($bypass -notcontains $serverHost) { $bypass += $serverHost }
    $env:NO_PROXY = ($bypass -join ',')
    $env:no_proxy = $env:NO_PROXY

    Step "Check the simulation service"
    $health = Invoke-WithRetry -Description "The simulation service" -Operation {
        Invoke-RestMethod -Method Get -Uri "$ServerUrl/api/v1/health" -TimeoutSec 10
    }
    if ($health.authentication_required) {
        Fail "This service requires authenticated pairing. Contact the service administrator."
    }

    Step "Check the local runtime"
    $python = Find-Python310
    if (-not $python) {
        $winget = Get-Command winget.exe -ErrorAction SilentlyContinue
        if ($winget) {
            Write-Host "Python 3.10+ is missing. Installing Python 3.12 for the current user..."
            & $winget.Source install --id Python.Python.3.12 --exact --silent --scope user `
                --accept-package-agreements --accept-source-agreements --disable-interactivity
            Refresh-ProcessPath
            $python = Find-Python310
        }
        if (-not $python) {
            Fail "Python 3.10+ is required and automatic installation was unavailable or blocked. Install Python 3.12 from your company Software Center, or https://www.python.org/downloads/windows/, then run this file again."
        }
    }
    Write-Host "Python ready: $python" -ForegroundColor Green

    Step "Download the matching Windows component"
    New-Item -ItemType Directory -Force -Path $WorkRoot, $Expanded | Out-Null
    $download = Invoke-WithRetry -Description "The Windows component download" -Operation {
        Remove-Item -LiteralPath $Archive -Force -ErrorAction SilentlyContinue
        Invoke-WebRequest -UseBasicParsing `
            -Uri "$ServerUrl/api/v1/windows-connector/package.zip" `
            -OutFile $Archive -PassThru -TimeoutSec 120
    }
    $expectedHash = [string]$download.Headers["X-Content-SHA256"]
    if ($expectedHash -notmatch '^sha256:[0-9a-f]{64}$') {
        Fail "The service did not provide a valid package checksum."
    }
    $actualHash = "sha256:" + (Get-Sha256 -Path $Archive)
    if ($actualHash -ne $expectedHash.ToLowerInvariant()) {
        Fail "The downloaded package checksum does not match the service."
    }
    Expand-Archive -LiteralPath $Archive -DestinationPath $Expanded -Force
    if (-not (Test-Path (Join-Path $Expanded "scripts\bootstrap.ps1"))) {
        Fail "The downloaded package is incomplete."
    }

    Step "Install and connect this PC"
    $forceRebind = Get-OneClickRebindRequired
    if ($forceRebind) {
        Write-Host "No unfinished tasks were found; automatically rebinding this PC to the current Web/SDK identity." -ForegroundColor Yellow
    }
    Backup-InstalledState
    $PreviousStateBackedUp = $true
    Stop-PreviousConnector
    Reset-InstalledApplication
    Copy-Item -Path (Join-Path $Expanded '*') -Destination $AppRoot -Recurse -Force
    $bootstrapArgs = @(
        "-Mode", $Mode,
        "-ControlPlane", "linux",
        "-ServerUrl", $ServerUrl,
        "-Owner", $Owner,
        "-InstallRoot", $InstallRoot,
        "-RegisterStartup",
        "-Start"
    )
    if ($forceRebind) { $bootstrapArgs += "-ForceRebind" }
    & (Join-Path $AppRoot "scripts\bootstrap.ps1") @bootstrapArgs
    if ($LASTEXITCODE -ne 0) { Fail "The local component installation did not complete." }

    Write-Host "`nThis PC is connected. Return to the Web page and continue the task." -ForegroundColor Green
    Write-Host "Visual Studio is user-managed. The connector checks it and reports a clear build prerequisite if missing."
} catch {
    $failureMessage = $_.Exception.Message
    Write-Warning "Installation failed; attempting to restore the previous Connector transaction."
    Restore-PreviousConnector
    Fail $failureMessage
} finally {
    Remove-Item -LiteralPath $WorkRoot -Recurse -Force -ErrorAction SilentlyContinue
}
